rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/entries/{entryId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && isValidEntry(request.resource.data);
      allow update: if isOwner(userId) && isValidEntryUpdate(request.resource.data, resource.data);
      allow delete: if isOwner(userId);
    }
  }

  function isOwner(userId) {
    return request.auth != null && request.auth.uid == userId;
  }

  function entryFieldsValid(data) {
    return data.keys().hasAll(['site', 'username', 'password', 'createdAt'])
      && data.site is string
      && data.site.size() > 0
      && data.site.size() <= 200
      && data.username is string
      && data.username.size() <= 200
      && data.password is string
      && data.password.size() > 0
      && data.password.size() <= 500
      && data.createdAt is timestamp;
  }

  function isValidEntry(data) {
    return data.keys().hasOnly(['site', 'username', 'password', 'createdAt'])
      && entryFieldsValid(data);
  }

  function isValidEntryUpdate(newData, oldData) {
    return newData.keys().hasOnly(['site', 'username', 'password', 'createdAt'])
      && entryFieldsValid(newData)
      && newData.createdAt == oldData.createdAt;
  }
}
