{
  "name": "jpass",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "npm run build --workspaces",
    "build:ui": "npm run build --workspace=@jpass/ui",
    "build:extension": "npm run build --workspace=@jpass/extension",
    "smoke:vault": "node scripts/smoke-vault.mjs"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vite": "^7.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0"
  }
}
